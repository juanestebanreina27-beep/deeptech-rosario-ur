# =============================================================================
# FRONTEND (Vercel → Environment Variables)
# Solo variables públicas (anon). NUNCA service role ni API keys de IA.
# =============================================================================

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_APP_NAME=DeepTech Universidad del Rosario
VITE_PUBLIC_SITE_URL=https://your-app.vercel.app

# =============================================================================
# SUPABASE EDGE FUNCTION SECRETS (Dashboard → Edge Functions → Secrets)
# Estas NO van en Vercel del frontend.
# =============================================================================

# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Informes IA (OPCIONAL). Sin esto el producto igual evalúa descarte+score+IRL ---
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4.1-mini

# Alternativas:
# AI_PROVIDER=deepseek
# AI_API_KEY=
# AI_MODEL=deepseek-chat

# AI_PROVIDER=xai
# AI_API_KEY=
# AI_MODEL=grok-4.5

# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
